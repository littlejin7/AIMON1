# Claude AI (Anthropic) — 오답 AI 피드백용
ANTHROPIC_API_KEY="sk-ant-api03-..."

# JWT
SECRET_KEY="최소-32자-이상의-랜덤-문자열"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth 2.0 (Social Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Supabase
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_KEY="<anon-key>"
USE_SUPABASE="false"

# SendGrid (이메일 발송)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Admin API — 강제 로그아웃/밴용 (미설정 시 /admin 엔드포인트 전체 비활성화)
# 최소 32자 이상의 랜덤 문자열 권장: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=""

# 스케줄러 (스트릭 리마인더 이메일·일간 백업)
# 멀티워커 배포(gunicorn -w N 등)에서 중복 실행을 막으려면,
# 스케줄러를 담당할 워커 1개에만 RUN_SCHEDULER=1 을 부여하거나
# 별도 단일 프로세스로 분리한다.
# 로컬 단일 워커: 미설정 시 1로 취급(스케줄러 켜짐).
# RUN_SCHEDULER=1
