            "",
            "w = Warrior(\"전사\", 200, \"검\")",
            "print(w.name, w.hp, w.weapon)"
          ],
          "output": [
            "전사 200 검"
          ]
        },
        "tip": "super().__init__()을 빠뜨리면 self.name, self.hp가 설정되지 않아 오류가 나요."
      },
