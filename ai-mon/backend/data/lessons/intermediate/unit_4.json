            "        self.weapon = weapon",
            "",
            "    def status(self):  # 부모 메서드 오버라이딩",
            "        print(f\"{self.name} — HP: {self.hp} / 무기: {self.weapon}\")",
            "",
            "w = Warrior(\"전사\", 200, \"검\")",
            "w.status()"
          ],
          "output": [
            "전사 — HP: 200 / 무기: 검"
          ]
        },
        "tip": "오버라이딩 = 부모 메서드를 자식 입맛에 맞게 교체하는 것"
      },
