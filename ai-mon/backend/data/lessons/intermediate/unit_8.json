            "print(r.status_code)",
            "print(r.json()[\"title\"])"
          ],
          "output": [
            "200",
            "수정된 제목"
          ]
        },
        "tip": "REST API에서 PUT은 멱등(idempotent): 같은 요청을 여러 번 해도 결과가 동일합니다."
      },
      {
        "order": 2,
        "text": "DELETE 요청은 서버의 리소스를 삭제합니다.\n성공 시 보통 200 또는 204 No Content를 반환합니다.",
        "terminal": {
          "code": [
            "r = requests.delete('https://jsonplaceholder.typicode.com/posts/1')",
            "print(r.status_code)"
          ],
          "output": [
            "200"
          ]
        },
        "tip": "204는 응답 본문 없이 성공했다는 의미입니다. r.text는 빈 문자열입니다."
      },
      {
        "order": 3,
        "text": "requests.Session()은 여러 요청에 걸쳐 헤더, 쿠키 등을 유지합니다.\n매 요청마다 인증 헤더를 반복하지 않아도 됩니다.",
        "terminal": {
          "code": [
            "session = requests.Session()",
            "session.headers.update({\"Authorization\": \"Bearer MY_TOKEN\"})",
            "r1 = session.get('https://api.example.com/users')",
            "r2 = session.get('https://api.example.com/posts')",
            "print(r1.status_code, r2.status_code)"
          ],
          "output": [
            "200 200"
          ]
        },
        "tip": "Session은 내부적으로 HTTP 연결을 재사용(Connection Pooling)하여 성능도 향상됩니다."
      },
      {
        "order": 4,
        "text": "Rate Limit(요청 횟수 제한)에 걸리면 429 Too Many Requests 응답이 반환됩니다.\n응답 헤더의 Retry-After 값만큼 대기 후 재시도합니다.",
        "terminal": {
          "code": [
            "headers = {\"Authorization\": \"Bearer MY_TOKEN\"}",
            "r = requests.get('https://api.example.com/data', headers=headers)",
            "if r.status_code == 429:",
            "    wait = int(r.headers.get(\"Retry-After\", 5))",
            "    print(f\"{wait}초 후 재시도\")",
            "    time.sleep(wait)"
          ],
          "output": []
        },
        "tip": "Retry-After 헤더가 없는 경우를 대비해 기본값(예: 5초)을 지정합니다."
      },
