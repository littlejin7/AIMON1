            "    params = {\"q\": city, \"appid\": api_key, \"units\": \"metric\"}",
            "    r = requests.get(url, params=params, timeout=5)",
            "    r.raise_for_status()",
            "    d = r.json()",
            "    return {\"city\": d[\"name\"], \"temp\": d[\"main\"][\"temp\"]}"
          ],
          "output": []
        },
