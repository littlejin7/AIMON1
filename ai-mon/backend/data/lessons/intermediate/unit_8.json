            "    json.dump(data, f, ensure_ascii=False, indent=2)",
            "print(\"저장 완료\")"
          ],
          "output": [
            "저장 완료"
          ]
        },
        "tip": "ensure_ascii=False로 지정해야 한글이 유니코드 이스케이프 없이 저장됩니다."
      },
      {
        "order": 6,
        "text": "저장한 JSON 파일을 불러와 로컬 데이터로 처리합니다.\nAPI 호출 없이도 동일한 파싱 로직을 테스트할 수 있습니다.",
        "terminal": {
          "code": [
            "with open('posts.json', 'r', encoding='utf-8') as f:",
            "    posts = json.load(f)",
            "print(f\"총 {len(posts)}개 게시글\")",
            "for post in posts[:3]:",
            "    print(post[\"id\"], post[\"title\"][:20])"
          ],
          "output": [
            "총 100개 게시글",
            "1 sunt aut facere rep",
            "2 qui est esse",
            "3 ea molestias quasi"
          ]
        },
        "tip": "json.load()는 파일에서, json.loads()는 문자열에서 JSON을 파싱합니다."
      }
