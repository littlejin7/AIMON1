            "    posts = collect_all(client, \"/posts\")",
            "    print(f\"{len(posts)}개 수집 완료\")",
            "    clean = extract_fields(posts, [\"id\", \"title\"])",
            "    save_csv(clean, \"output.csv\", [\"id\", \"title\"])",
