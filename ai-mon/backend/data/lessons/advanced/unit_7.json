            "",
            "function MemoList() {",
            "  const [memos, setMemos] = useState([]);",
            "  const [loading, setLoading] = useState(true);",
            "",
            "  useEffect(() => {",
            "    fetch(\"http://localhost:8000/memos\")",
            "      .then((res) => res.json())",
            "      .then((data) => {",
            "        setMemos(data.memos);",
            "        setLoading(false);",
            "      });",
            "  }, []);  // [] : 마운트 시 1회만 실행",
