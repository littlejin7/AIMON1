      {
        "order": 1,
        "text": "SQLAlchemy는 Python에서 데이터베이스를 객체처럼 다룰 수 있게 해주는 ORM(Object Relational Mapper)입니다.\nSQL을 직접 작성하는 대신 Python 클래스로 테이블을 정의하고, 메서드로 CRUD를 처리합니다.\nSQLite는 파일 하나로 동작하는 경량 DB로 개발·프로토타입 단계에 적합합니다.",
        "tip": "ORM을 쓰면 SQLite → PostgreSQL 전환 시 DATABASE_URL 한 줄만 바꾸면 됩니다. AI MON도 SQLite → PostgreSQL 마이그레이션 경로를 채택했습니다."
      },
      {
        "order": 2,
        "text": "Base 클래스를 상속받은 Python 클래스가 DB 테이블이 됩니다.\nColumn(타입, 옵션) 으로 각 컬럼을 정의하고, Base.metadata.create_all() 로 테이블을 생성합니다.",
        "terminal": {
          "code": [
            "from sqlalchemy import create_engine, Column, Integer, String",
            "from sqlalchemy.ext.declarative import declarative_base",
            "",
            "DATABASE_URL = \"sqlite:///./aimon.db\"",
            "engine = create_engine(DATABASE_URL, connect_args={\"check_same_thread\": False})",
            "Base = declarative_base()",
            "",
            "class Memo(Base):",
            "    __tablename__ = \"memos\"",
            "    id = Column(Integer, primary_key=True, index=True)",
            "    title = Column(String, nullable=False)",
            "    content = Column(String, default=\"\")",
            "",
            "Base.metadata.create_all(bind=engine)",
            "print(\"DB 테이블 생성 완료 — memos\")"
          ],
          "output": [
            "DB 테이블 생성 완료 — memos"
          ]
        }
      },
      {
        "order": 3,
        "text": "SessionLocal로 세션을 열고, add/commit/refresh 패턴으로 데이터를 저장합니다.\ncommit()은 트랜잭션을 DB에 확정하고, refresh()는 DB에서 최신 데이터(자동 생성된 id 등)를 다시 읽어옵니다.",
        "terminal": {
          "code": [
            "from sqlalchemy.orm import sessionmaker",
            "",
            "SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)",
            "db = SessionLocal()",
            "",
            "# INSERT",
            "new_memo = Memo(title=\"SQLAlchemy 학습\", content=\"ORM으로 DB 다루기\")",
            "db.add(new_memo)",
            "db.commit()",
            "db.refresh(new_memo)",
            "print(f\"저장 완료 — id: {new_memo.id}, title: {new_memo.title}\")",
            "",
            "# SELECT",
            "memos = db.query(Memo).all()",
            "print(f\"총 메모 수: {len(memos)}\")",
            "db.close()"
          ],
          "output": [
            "저장 완료 — id: 1, title: SQLAlchemy 학습",
            "총 메모 수: 1"
          ]
        }
      },
      {
        "order": 4,
        "text": "FastAPI의 Depends() 를 사용하면 요청마다 DB 세션을 자동으로 생성하고 응답 후 반드시 닫을 수 있습니다.\nyield 기반 제너레이터 함수로 세션 생명주기를 관리하는 것이 FastAPI 공식 패턴입니다.",
        "terminal": {
          "code": [
            "from fastapi import FastAPI, Depends",
            "from sqlalchemy.orm import Session",
            "",
            "app = FastAPI()",
            "",
            "def get_db():",
            "    db = SessionLocal()",
            "    try:",
            "        yield db        # 요청 처리 중 세션 사용",
            "    finally:",
            "        db.close()      # 응답 후 반드시 닫힘",
            "",
            "@app.get(\"/memos\")",
            "def list_memos(db: Session = Depends(get_db)):",
            "    memos = db.query(Memo).all()",
            "    return [{\"id\": m.id, \"title\": m.title} for m in memos]",
            "",
            "# GET /memos 요청 시:"
          ],
          "output": [
            "[{\"id\": 1, \"title\": \"SQLAlchemy 학습\"}]"
          ]
        },
        "tip": "Depends(get_db) 는 함수를 호출해 세션을 주입합니다. yield 덕분에 예외가 발생해도 finally 의 db.close() 가 반드시 실행됩니다."
      },
      {
        "order": 5,
        "text": "POST(생성)와 DELETE(삭제) 엔드포인트를 추가해 완전한 CRUD API를 완성합니다.\nfilter().first() 는 조건에 맞는 첫 레코드를 반환하고, 없으면 None 을 반환합니다.",
        "terminal": {
          "code": [
            "from fastapi import FastAPI, Depends, HTTPException",
            "from pydantic import BaseModel",
            "from sqlalchemy.orm import Session",
            "",
            "app = FastAPI()",
            "",
            "class MemoCreate(BaseModel):",
            "    title: str",
            "    content: str = \"\"",
            "",
            "@app.post(\"/memos\", status_code=201)",
            "def create_memo(memo: MemoCreate, db: Session = Depends(get_db)):",
            "    new = Memo(title=memo.title, content=memo.content)",
            "    db.add(new)",
            "    db.commit()",
            "    db.refresh(new)",
            "    return {\"id\": new.id, \"title\": new.title}",
            "",
            "@app.delete(\"/memos/{memo_id}\")",
            "def delete_memo(memo_id: int, db: Session = Depends(get_db)):",
            "    memo = db.query(Memo).filter(Memo.id == memo_id).first()",
            "    if not memo:",
            "        raise HTTPException(status_code=404, detail=\"메모 없음\")",
            "    db.delete(memo)",
            "    db.commit()",
            "    return {\"deleted\": memo_id}",
            "",
            "# POST /memos  Body: {\"title\": \"DB 연동\"} 요청 시:"
          ],
          "output": [
            "{\"id\": 1, \"title\": \"DB 연동\"}"
          ]
        }
      },
      {
        "order": 6,
        "text": "PUT 엔드포인트로 기존 레코드를 수정합니다.\nfilter().first() 로 대상을 찾고 필드를 직접 변경한 뒤 commit() 으로 저장합니다.",
        "terminal": {
          "code": [
            "from fastapi import FastAPI, Depends, HTTPException",
            "from pydantic import BaseModel",
            "from sqlalchemy.orm import Session",
            "from typing import Optional",
            "",
            "app = FastAPI()",
            "",
            "class MemoUpdate(BaseModel):",
            "    title: Optional[str] = None",
            "    content: Optional[str] = None",
            "",
            "@app.put(\"/memos/{memo_id}\")",
            "def update_memo(memo_id: int, update: MemoUpdate,",
            "                db: Session = Depends(get_db)):",
            "    memo = db.query(Memo).filter(Memo.id == memo_id).first()",
            "    if not memo:",
            "        raise HTTPException(status_code=404, detail=\"메모 없음\")",
            "    if update.title is not None:",
            "        memo.title = update.title",
            "    if update.content is not None:",
            "        memo.content = update.content",
            "    db.commit()",
            "    db.refresh(memo)",
            "    return {\"id\": memo.id, \"title\": memo.title}",
            "",
            "# PUT /memos/1  Body: {\"title\": \"수정된 제목\"} 요청 시:"
          ],
          "output": [
            "{\"id\": 1, \"title\": \"수정된 제목\"}"
          ]
        },
        "tip": "Optional 필드를 사용하면 전달된 필드만 수정하는 부분 업데이트(PATCH 패턴)를 구현할 수 있습니다."
      },
      {
        "order": 7,
        "text": "filter()로 조건 검색을, order_by()로 정렬을, offset/limit으로 페이지네이션을 구현합니다.\n대용량 데이터를 다룰 때 전체를 한 번에 반환하면 성능이 떨어지므로 페이지네이션은 필수입니다.",
        "terminal": {
          "code": [
            "from fastapi import FastAPI, Depends",
            "from sqlalchemy.orm import Session",
            "",
            "app = FastAPI()",
            "",
            "@app.get(\"/memos/search\")",
            "def search_memos(",
            "    keyword: str = \"\",",
            "    skip: int = 0,",
            "    limit: int = 10,",
            "    db: Session = Depends(get_db)",
            "):",
            "    query = db.query(Memo)",
            "    if keyword:",
            "        query = query.filter(Memo.title.contains(keyword))",
            "    total = query.count()",
            "    memos = query.order_by(Memo.id.desc()).offset(skip).limit(limit).all()",
            "    return {",
            "        \"total\": total,",
            "        \"page\": skip // limit + 1,",
            "        \"memos\": [{\"id\": m.id, \"title\": m.title} for m in memos]",
            "    }",
            "",
            "# GET /memos/search?keyword=FastAPI&skip=0&limit=5 요청 시:"
          ],
          "output": [
            "{\"total\": 2, \"page\": 1, \"memos\": [{\"id\": 2, \"title\": \"FastAPI + AI 연동\"}, {\"id\": 1, \"title\": \"FastAPI 학습\"}]}"
          ]
        },
        "tip": "order_by(Memo.id.desc()) 는 최신 항목을 먼저 반환합니다. .asc() 는 오름차순입니다."
      }
    ]
  },
