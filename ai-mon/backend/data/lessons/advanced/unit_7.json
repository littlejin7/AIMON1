            "  if (loading) return <p>로딩 중...</p>;",
            "  return <ul>{memos.map((m) => <li key={m.id}>{m.title}</li>)}</ul>;",
            "}",
            "",
            "// 렌더링 결과 (memos: [{id:1, title:\"FastAPI 학습\"}]):"
          ],
          "output": [
            "• FastAPI 학습"
          ]
        },
        "tip": "useEffect 의 두 번째 인자 [] 는 의존성 배열입니다. 빈 배열이면 마운트 1회, 값이 있으면 해당 값 변경 시마다 실행됩니다."
