          ]
        },
        "tip": "@app.on_event(\"startup\") 은 deprecated 되었습니다. lifespan 방식을 사용하세요."
      },
      {
        "order": 5,
        "text": "종합 실전: 질문을 Claude API로 처리하고 DB에 기록하는 /chat 엔드포인트입니다.\nFastAPI + Pydantic + SQLAlchemy + Claude API 가 한 엔드포인트에서 협력하는 풀스택 AI 서비스의 완성 형태입니다.",
        "terminal": {
          "code": [
            "from fastapi import FastAPI, Depends",
            "from pydantic import BaseModel",
            "from sqlalchemy import Column, Integer, String",
            "from sqlalchemy.orm import Session",
            "from anthropic import Anthropic",
            "",
            "app = FastAPI()",
            "client = Anthropic()",
            "",
            "class QnA(Base):",
            "    __tablename__ = \"qna\"",
            "    id = Column(Integer, primary_key=True)",
            "    question = Column(String)",
            "    answer = Column(String)",
            "",
            "class ChatRequest(BaseModel):",
            "    question: str",
            "",
            "@app.post(\"/chat\")",
            "def chat(req: ChatRequest, db: Session = Depends(get_db)):",
            "    response = client.messages.create(",
            "        model=\"claude-haiku-4-5-20251001\",",
            "        max_tokens=256,",
            "        messages=[{\"role\": \"user\", \"content\": req.question}]",
            "    )",
            "    answer = response.content[0].text",
            "    db.add(QnA(question=req.question, answer=answer))",
            "    db.commit()",
            "    return {\"question\": req.question, \"answer\": answer}",
            "",
            "# POST /chat  Body: {\"question\": \"FastAPI 핵심 장점은?\"} 요청 시:"
