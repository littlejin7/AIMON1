      {
        "order": 4,
        "text": "st.chat_message()는 역할별 말풍선 UI를 렌더링합니다.\n'user'는 오른쪽, 'assistant'는 왼쪽에 아바타와 함께 표시됩니다.",
        "terminal": {
          "code": [
            "import streamlit as st",
            "",
            "with st.chat_message('user'):",
