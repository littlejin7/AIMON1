      },
      {
        "order": 5,
        "text": "st.chat_input()은 하단 고정 입력창을 생성합니다.\n사용자가 Enter를 누르면 입력값을 반환하고 입력창은 자동으로 초기화됩니다.",
        "terminal": {
          "code": [
            "import streamlit as st",
            "",
            "prompt = st.chat_input('메시지를 입력하세요...')",
