            "    async def wrapper(*args, **kwargs):",
            "        start = time.time()",
            "        result = await func(*args, **kwargs)",
            "        print(f\"{func.__name__}: {time.time()-start:.3f}초\")",
            "        return result",
            "    return wrapper",
            "",
            "async def fetch_score(sem, student_id):",
            "    async with sem:",
            "        await asyncio.sleep(0.02)   # API 요청 모의",
            "        return {\"id\": student_id, \"score\": 70 + student_id}",
            "",
            "@async_timer",
            "async def collect_scores(student_ids):",
            "    sem = asyncio.Semaphore(3)",
            "    tasks = [fetch_score(sem, sid) for sid in student_ids]",
            "    return await asyncio.gather(*tasks, return_exceptions=True)",
