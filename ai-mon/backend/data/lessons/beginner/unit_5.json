            "    print(sum(args))",
            "total(1, 2, 3)",
            "total(10, 20)"
          ],
          "output": [
            "(1, 2, 3)",
            "6",
            "(10, 20)",
            "30"
          ]
        },
        "tip": "`*args`를 쓰면 인수를 몇 개 전달하든 전부 받을 수 있어요. 받은 값은 튜플로 저장돼요."
      },
      {
        "order": 2,
        "text": "`**kwargs`는 키워드 인수를 개수 제한 없이 받을 때 사용해요.\n전달된 인수들이 딕셔너리로 묶여서 함수에 전달돼요.\n`kwargs`는 관례적인 이름이고, `**`가 핵심이에요.",
        "terminal": {
          "code": [
            "def show_info(**kwargs):",
            "    print(kwargs)",
            "    for key, value in kwargs.items():",
            "        print(key, ':', value)",
            "show_info(name='철수', score=95)"
          ],
          "output": [
            "{'name': '철수', 'score': 95}",
            "name : 철수",
            "score : 95"
          ]
        },
        "tip": "`**kwargs`를 쓰면 `키=값` 형태로 인수를 몇 개 전달하든 딕셔너리로 받을 수 있어요."
      },
      {
        "order": 3,
        "text": "`*args`와 `**kwargs`를 함께 쓸 수 있어요.\n순서는 반드시 일반 매개변수 → `*args` → `**kwargs` 순이어야 해요.",
        "terminal": {
          "code": [
            "def describe(title, *args, **kwargs):",
            "    print('제목:', title)",
            "    print('항목:', args)",
            "    print('정보:', kwargs)",
            "describe('결과', 85, 92, unit='점', grade='B')"
          ],
          "output": [
