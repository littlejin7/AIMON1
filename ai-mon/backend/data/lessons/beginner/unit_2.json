        "terminal": {
          "code": [
            "text = 'Python'",
            "print(text[-1])",
            "print(text[-2])"
          ],
          "output": [
            "n",
            "o"
          ]
        },
        "tip": "-1이 마지막 글자, -2가 그 앞 글자예요."
