            "    task = queue.pop(0)",
            "    print(f'처리 중: {task}')",
            "print('모든 작업 완료')"
          ],
          "output": [
            "처리 중: 작업1",
            "처리 중: 작업2",
            "처리 중: 작업3",
            "모든 작업 완료"
          ]
        },
        "tip": "`while 리스트:`는 리스트가 비어 있지 않으면 True예요. 큐 처리 패턴이에요."
      },
      {
        "order": 5,
        "text": "for, while, break, continue, 리스트, 딕셔너리를 모두 조합해서 실용적인 코드를 만들어요.",
        "terminal": {
          "code": [
            "# 코드",
            "inventory = {'사과': 5, '바나나': 0, '포도': 3, '딸기': 8}",
            "available = []",
            "for item, qty in inventory.items():",
            "    if qty == 0:",
            "        continue",
            "    available.append(f'{item}({qty}개)')",
            "    if len(available) == 2:",
            "        break",
            "print('추천 상품:', ', '.join(available))"
          ],
          "output": [
            "추천 상품: 사과(5개), 포도(3개)"
          ]
        },
        "tip": "for + continue + break + 딕셔너리를 조합하면 실용적인 필터링 코드를 만들 수 있어요."
      }
    ]
  }
