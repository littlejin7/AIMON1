flowchart TD
    subgraph EVENTS["학습 이벤트 발생 지점"]
        E1["스테이지 클리어"]
        E2["미니보스 클리어"]
        E3["보스 클리어"]
        E4["게임 클리어"]
        E5["AI 피드백"]
        E6["오답 복습"]
        E7["출석 login"]
    end

    APPLY["apply_xp(user, amount, event_type)<br/>★ 단일 진입점<br/>XP 가산 + 레벨/진화 + 미션 훅"]

    E1 --> APPLY
    E2 --> APPLY
    E3 --> APPLY
    E4 --> APPLY
    E5 --> APPLY
    E6 --> APPLY
    E7 -. "XP 없음: 직접 호출(예외)" .-> BUMP

    APPLY --> BUMP["bump_mission(user, event)<br/>활성 미션 진척 갱신"]

    BUMP --> DAILY["데일리 진척 +1<br/>d_quiz3 · d_review · d_login"]
    BUMP --> WEEKLY["위클리 진척 +1<br/>w_boss2 · w_ai5 · w_streak5"]

    DAILY -- "포함관계: 데일리 이벤트가<br/>위클리도 같이 굴림" --> WEEKLY
    DAILY -- "d_login 완료일 → login_days 집합" --> WEEKLY

    DAILY --> STORE
    WEEKLY --> STORE["users.missions (jsonb)<br/>date / week 다르면 lazy reset(KST)"]

    STORE --> GET["GET /missions<br/>목록 + 진척 + 수령상태"]
    GET --> UI["프론트 미션 위젯<br/>진척바 + 수령 버튼"]

    UI -- "수동 claim" --> CLAIM["POST /missions/claim<br/>완료 검증 + 멱등(claimed)"]
    STORE -. "출석류 auto_claim" .-> CLAIM
    CLAIM --> REWARD["보상 지급<br/>apply_xp / 왕관 헬퍼 재사용"]
    REWARD -. "지급된 XP가 다시 이벤트로" .-> APPLY

    classDef entry fill:#7c3aed,stroke:#4c1d95,color:#fff;
    classDef store fill:#1e293b,stroke:#475569,color:#fff;
    classDef reward fill:#059669,stroke:#065f46,color:#fff;
    class APPLY entry;
    class STORE store;
    class REWARD reward;
